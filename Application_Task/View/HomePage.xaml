<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Application_Task.View.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converter="clr-namespace:Application_Task.Libraries.Converts"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <converter:BoolToTextDecorationStrike x:Key="BoolToDecorationStrike" />
    </ContentPage.Resources>

    <Grid RowDefinitions="50, *">

        <Border
            Margin="20,15,20,0"
            BackgroundColor="Transparent"
            HeightRequest="38"
            StrokeShape="RoundRectangle 20"
            StrokeThickness="0">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="SerchBarHomePage" />
            </Border.GestureRecognizers>

            <Grid ColumnDefinitions="Auto, *">
                <Image
                    Grid.Column="0"
                    Margin="2,0,5,0"
                    HeightRequest="30"
                    Source="find.png"
                    WidthRequest="30" />
                <Entry
                    x:Name="Entry_search"
                    Grid.Column="1"
                    Placeholder="Pesquisar..."
                    PlaceholderColor="Gray" />
            </Grid>
        </Border>

        <CollectionView x:Name="CollectionViewTask" Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="5,10" ColumnDefinitions="70, *, 70">
                        <CheckBox
                            Grid.Column="0"
                            HorizontalOptions="Center"
                            IsChecked="{Binding IsCompleted}">
                            <CheckBox.GestureRecognizers>
                                <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OncheckedBox" />
                            </CheckBox.GestureRecognizers>
                        </CheckBox>

                        <StackLayout Grid.Column="1">
                            <Label
                                FontAttributes="Bold"
                                Text="{Binding Name}"
                                TextDecorations="{Binding IsCompleted, Converter={StaticResource BoolToDecorationStrike}}" />
                            <Label
                                Text="{Binding TaskDate}"
                                TextColor="Gray"
                                TextDecorations="{Binding IsCompleted, Converter={StaticResource BoolToDecorationStrike}}" />
                        </StackLayout>

                        <Button
                            Grid.Column="2"
                            Padding="0"
                            BackgroundColor="Gray"
                            CornerRadius="22"
                            HeightRequest="44"
                            ImageSource="trash.png"
                            WidthRequest="44">
                            <Button.GestureRecognizers>
                                <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnTappedToDelete" />
                            </Button.GestureRecognizers>
                        </Button>

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label
            x:Name="Emptylbl"
            Grid.Row="1"
            HorizontalOptions="Center"
            Text="O que vamos fazer hoje?"
            TextColor="{StaticResource Gray200}"
            VerticalOptions="Center" />
        <Button
            Grid.Row="1"
            Margin="20"
            Clicked="ButtonToAdd"
            HorizontalOptions="Center"
            Text="+    Adicionar Tarefa"
            VerticalOptions="End" />
    </Grid>
</ContentPage>