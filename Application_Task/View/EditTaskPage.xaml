<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Application_Task.View.EditTaskPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="EditTaskPage">

    <Grid>
        <BoxView
            HeightRequest="5"
            VerticalOptions="Start"
            Color="{StaticResource Black}" />

        <VerticalStackLayout Padding="20">
            <Button
                Margin="0,0,0,10"
                Padding="0"
                Clicked="CloseModal"
                CornerRadius="25"
                HeightRequest="50"
                HorizontalOptions="End"
                Text=" X "
                WidthRequest="50" />

            <Border StrokeShape=" RoundRectangle 10">
                <Entry Placeholder="Tarefa.." />
            </Border>

            <Border StrokeShape=" RoundRectangle 10">
                <Editor HeightRequest="150" Placeholder="Descrição.." />
            </Border>

            <Border StrokeShape=" RoundRectangle 10">
                <DatePicker x:Name="DateTask" />
            </Border>


            <Grid ColumnDefinitions="Auto, *, Auto">
                <Label
                    Grid.Column="0"
                    Text="Etapas (Subtarefas)"
                    VerticalOptions="Center" />
                <Button
                    Grid.Column="2"
                    Margin="0,10,0,0"
                    Padding="0"
                    Clicked="Addstep"
                    CornerRadius="22"
                    HeightRequest="44"
                    Text="+"
                    WidthRequest="44" />
            </Grid>

            <Grid ColumnDefinitions="30, *, 30">
                <CheckBox />
                <Label
                    Grid.Column="1"
                    Text="Etapa"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="2"
                    Text="Trash"
                    VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>
        <Button
            Margin="15"
            Clicked="SaveData"
            HorizontalOptions="Center"
            Text="Salvar"
            VerticalOptions="End" />
    </Grid>
</ContentPage>